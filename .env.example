# ==============================================================================
# OSINT-RECON Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Update the values for your local environment.
# 3. NEVER commit your actual .env file to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Reconnaissance Engine Configuration
DEFAULT_TIMEOUT_SECONDS=15
USER_AGENT=OSINT-RECON-Engine/1.0
ENABLE_PASSIVE_RECON=true
ENABLE_ACTIVE_RECON=false

# Target Scopes & Network Validation
LAB_TARGET_SUBNET=192.168.56.0/24
REQUIRE_EXPLICIT_AUTHORIZATION=true

# Local Lab Target Credentials & Settings (Safe Lab Only)
LAB_DEFAULT_HOST=192.168.56.111

# External API Integrations (Optional / Future Phases)
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=

