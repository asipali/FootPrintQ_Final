# ==============================================================================
# OSINT-RECON Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Update the values for your local environment.
# 3. NEVER commit your actual .env file to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Reconnaissance Engine Configuration
DEFAULT_TIMEOUT_SECONDS=15
USER_AGENT=OSINT-RECON-Engine/1.0
ENABLE_PASSIVE_RECON=true
ENABLE_ACTIVE_RECON=false

# Target Scopes & Network Validation
LAB_TARGET_SUBNET=192.168.56.0/24
REQUIRE_EXPLICIT_AUTHORIZATION=true

# Local Lab Target Credentials & Settings (Safe Lab Only)
LAB_DEFAULT_HOST=192.168.56.111

# External API Integrations (Optional / Future Phases)
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=

# ==============================================================================
# Tenable Nessus Vulnerability Scanner REST API Configuration
# ==============================================================================
# Base URL for Nessus REST API. When running on Kali: https://127.0.0.1:8834.
# If connecting from Windows host to Kali guest VM: https://<KALI_IP>:8834
NESSUS_URL=https://127.0.0.1:8834
# Nessus API Keys (generate in Nessus Web UI -> My Account -> API Keys)
# Format: accessKey=<64-char-hex>; secretKey=<64-char-hex>
NESSUS_ACCESS_KEY=<configured-in-environment>
NESSUS_SECRET_KEY=<configured-in-environment>
# TLS Certificate Verification (set to false for local lab self-signed certificates)
NESSUS_VERIFY_SSL=false
# Default Scan Template UUID (leave blank for automatic template discovery)
NESSUS_DEFAULT_TEMPLATE_UUID=


